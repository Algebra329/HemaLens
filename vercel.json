{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "ml": {
      "root": "ml",
      "runtime": "python"
    },
    "web": {
      "root": "web",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}